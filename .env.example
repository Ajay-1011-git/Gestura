# Copy to .env and fill in real values. Never commit .env.

GROQ_API_KEY=              # Groq free-tier key — https://console.groq.com
OBS_VIRTUALCAM_DEVICE=      # OS-specific virtual camera device name/index,
                            # confirm the actual name after OBS Virtual Camera is started
CURATED_VOCAB_PATH=./data/vocab/       # directory of curated .pose entries, see T1.2
LEXICON_PATH=./data/lexicon/           # spoken-to-signed-translation lexicon dir, see T1.9
AVATAR_GLB_PATH=./assets/avatar.glb    # exported per architecture v3 §7

# --- Stage 2 additions (build instructions §B.1) -----------------------------
# Chosen after real benchmarking on the target machine — see T2.4 and
# scripts/benchmark_fallback.py. Not a guess.
OLLAMA_MODEL=qwen3:4b
# The MLX Whisper model the local STT fallback loads. WhisperLiveKit's current
# --backend options were re-checked in-session (2026-09-15): auto, mlx-whisper,
# faster-whisper, whisper, openai-api, funasr, voxtral-mlx, voxtral, qwen3-vllm,
# qwen3-vllm-metal, qwen3-streaming, canary. This names the model its
# mlx-whisper backend drives.
WHISPERLIVEKIT_BACKEND=mlx-community/whisper-small.en-mlx
# Tuned against Stage 1's real observed latency, not a round number: a live
# to_gloss call measured 0.46-1.48s (median 0.80s) on this machine, and Stage 1
# reported ~1.8s end-to-end. 3000ms is ~2x the observed worst case.
SAFE_MODE_LATENCY_THRESHOLD_MS=3000
# How far behind the conversation the oldest unserved segment may fall.
SAFE_MODE_QUEUE_AGE_THRESHOLD_S=5
DOMAIN_GLOSSARY_DEFAULT=general     # general | medical | technical
